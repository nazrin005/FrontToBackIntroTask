<section class="ftco-section">
	<div class="container">
		<div class="row justify-content-center pb-5">
			<div class="col-md-7 heading-section text-center ftco-animate">
				<span class="subheading">our delightful offerings</span>
				<h2>tastefully yours</h2>
			</div>
		</div>
		<div class="row">
			@{
				foreach(var item in Model.Products)
				{
					<div class="col-md-3 d-flex">
						<div class="product ftco-animate">
							
								<div class="img d-flex align-items-center justify-content-center" style="background-image: url(/assets/images/@item.Images.FirstOrDefault(i => i.IsPrimary)?.Url">
									<div class="desc">
										<p class="meta-prod d-flex">
										<a asp-controller="Home" asp-action="Details" asp-route-id="@item.Id"><span class="flaticon-shopping-bag"></span></a>
											<a href="#" class="d-flex align-items-center justify-content-center"><span class="flaticon-heart"></span></a>
											<a href="#" class="d-flex align-items-center justify-content-center"><span class="flaticon-visibility"></span></a>
										</p>
									</div>
								</div>
							
							
							<div class="text text-center">
								<span class="sale">sale</span>
								<span class="category">brandy</span>
								<h2>@item.Title</h2>
								<p class="mb-0"><span class="price price-sale">$@item.Price</span> <span class="price">$@item.Discount</span></p>
							</div>
						</div>
					</div>
				}
		     }
			
			
		</div>
		<div class="row justify-content-center">
			<div class="col-md-4">
				<a href="product.html" class="btn btn-primary d-block">view all products <span class="fa fa-long-arrow-right"></span></a>
			</div>
		</div>
	</div>
</section>
  
